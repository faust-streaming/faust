#!/bin/sh

export PREFIX=""
if [ -d 'venv' ] ; then
    export PREFIX="venv/bin/"
fi

set -ex

if [ -z $GITHUB_ACTIONS ]; then
    scripts/check
fi

# `-n auto` shards the suite across one worker process per core.  On the
# 4-core CI runners this takes the run from ~127s to ~49s with coverage on,
# and pytest-cov merges the per-worker data files, so the resulting report is
# identical -- same statements, same branches, same total.  It comes last
# before "$@" so a caller can still force serial (`scripts/tests -n0`) when a
# failure needs a readable traceback or a debugger.
${PREFIX}pytest tests/unit tests/functional tests/integration tests/meticulous/ tests/regression -n auto $@
${PREFIX}bandit -b extra/bandit/baseline.json -c extra/bandit/config.yaml -r faust

#if [ -z $GITHUB_ACTIONS ]; then
#    scripts/coverage
#fi
